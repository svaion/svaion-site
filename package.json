{
  "name": "svaion-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node tools/headers/write-headers.mjs out",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "parity": "bash tools/parity/parity.sh reference/homepage-v10.html http://127.0.0.1:4173/ tools/parity/spec.json .parity",
    "preview": "node tools/preview/serve.mjs out --port 4173",
    "check:csp": "node tools/headers/check-csp.mjs http://127.0.0.1:4173"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
